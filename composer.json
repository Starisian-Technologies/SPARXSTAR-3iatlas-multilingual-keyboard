{
  "name": "starisian/sparxstar-3iatlas-multilingual-keyboard",
  "description": "Tooling scaffold for the proprietary 3iAtlas multilingual keyboard WordPress plugin.",
  "type": "wordpress-muplugin",
  "license": "proprietary",
  "require": {
    "php": "^8.2 || ^8.3"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "autoload": {
    "psr-4": {
      "Starisian\\Sparxstar\\Atlas\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Starisian\\Sparxstar\\Atlas\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml",
    "lint:fix": "phpcbf --standard=phpcs.xml",
    "analyse": "phpstan analyse --configuration=phpstan.neon",
    "test:unit": "phpunit --configuration=phpunit.xml"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
