{
	"name": "@starisian/3iatlas-multilingual-input-react",
	"version": "0.1.0",
	"description": "React bindings for 3iAtlas multilingual text input.",
	"license": "SEE LICENSE IN LICENSE.md",
	"sideEffects": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "restricted"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@starisian/3iatlas-multilingual-input-core": "workspace:*",
		"@starisian/3iatlas-multilingual-input-keyman": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	}
}
