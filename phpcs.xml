<?xml version="1.0"?>
<!-- PHPCS rules for future PHP source and mirrored tests. -->
<ruleset name="SPARXSTAR 3iAtlas">
    <description>Enforces WordPress and project PHP conventions.</description>
    <file>src</file>
    <file>tests</file>
    <file>mu-plugins</file>
    <arg name="extensions" value="php" />
    <arg name="parallel" value="8" />
    <rule ref="PSR12">
        <!-- Project policy intentionally places strict_types before file docs. -->
        <exclude name="PSR12.Files.FileHeader.SpacingAfterBlock" />
        <exclude name="PSR12.Files.FileHeader.IncorrectOrder" />
        <!-- PHPUnit test methods intentionally use the required snake_case form. -->
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
    </rule>
    <rule ref="WordPress.Security" />
    <rule ref="WordPress.DB" />
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedNamespaceFound" />
        <properties>
            <property name="prefixes" type="array">
                <element value="sparxstar_3iatlas" />
            </property>
        </properties>
    </rule>
</ruleset>
