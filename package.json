{
	"name": "sparxstar-3iatlas-multilingual-input-workspace",
	"version": "0.1.0",
	"private": true,
	"description": "Workspace for the 3iAtlas multilingual input client package.",
	"license": "SEE LICENSE IN LICENSE.md",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@9.15.9",
	"scripts": {
		"build": "pnpm -r --filter './packages/*' run build",
		"clean": "pnpm -r --filter './packages/*' run clean",
		"lint": "eslint .",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"test": "jest --runInBand",
		"validate": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run build"
	},
	"devDependencies": {
		"@jest/globals": "^29.7.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/jest": "^29.5.14",
		"@types/react": "^18.3.24",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^8.42.0",
		"@typescript-eslint/parser": "^8.42.0",
		"eslint": "^9.35.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"prettier": "^3.6.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"ts-jest": "^29.4.2",
		"tsup": "^8.5.0",
		"typescript": "^5.9.2"
	}
}
