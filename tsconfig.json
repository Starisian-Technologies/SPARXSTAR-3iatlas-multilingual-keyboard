{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@starisian/3iatlas-multilingual-input": [
				"packages/multilingual-input/src"
			],
			"@starisian/3iatlas-multilingual-input-core": ["packages/core/src"],
			"@starisian/3iatlas-multilingual-input-adapters": [
				"packages/adapters/src"
			],
			"@starisian/3iatlas-multilingual-input-keyman": ["packages/keyman/src"],
			"@starisian/3iatlas-multilingual-input-profiles": [
				"packages/profiles/src"
			],
			"@starisian/3iatlas-multilingual-input-react": ["packages/react/src"],
			"@starisian/3iatlas-input-ink": ["packages/ink/src"],
			"@starisian/3iatlas-input-recognition": ["packages/recognition/src"]
		}
	},
	"include": [
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"tests/**/*.ts",
		"tests/**/*.tsx"
	]
}
